# Copy to .env and adjust as needed. `docker compose up` picks this up automatically.

# --- Simulated clock ---
# 1 simulated "day" = this many wall-clock seconds. 300 (5 min) is a good
# demo default; drop it to 60 for a fast end-to-end smoke test.
SIM_DAY_SECONDS=300

# --- Fleet simulator ---
FLEET_SIZE=24
TICK_SECONDS=3
CHRONICALLY_IDLE_FRACTION=0.15

# --- Observability thresholds ---
STALENESS_THRESHOLD_SECONDS=60
IDLE_THRESHOLD_SECONDS=120
WATCHDOG_INTERVAL_SECONDS=30

# --- Postgres ---
POSTGRES_USER=fleetiq
POSTGRES_PASSWORD=fleetiq
POSTGRES_DB=fleetiq

# --- Airflow ---
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
# Airflow's own Fernet key for encrypting connection passwords at rest.
# Any 32-byte urlsafe-base64 string works; this is a fixed demo value -
# generate your own with `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
# for anything beyond local coursework use.
AIRFLOW_FERNET_KEY=CseXpAu23tB2k24yXt_ZY-ZaNrPYvcMW6FpGKdFk_SY=
